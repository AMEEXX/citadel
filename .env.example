# =======================================================================
# CITADEL ASSESSMENT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================================
# Copy this file to .env and modify values to match your deployment environment.

# ----------------------------------------------------------------------
# APPLIANCE NETWORK SETTINGS
# ----------------------------------------------------------------------
# Host interface to bind server (0.0.0.0 binds all interfaces on the exam LAN)
CITADEL_HOST=0.0.0.0

# Port for exam traffic (HTTP/HTTPS)
CITADEL_PORT=8443

# ----------------------------------------------------------------------
# OPERATIONAL SECURITY MODE (TESTING VS P/RODUCTION)
# ----------------------------------------------------------------------
# 0 = Testing Mode (Open LAN access, Explorer preserved, early exit allowed)
# 1 = Production Mode (Gated by cryptographic token, Explorer terminated, 
#     Zero-Internet WFP firewall active, 15m early exit rule enforced)
CITADEL_PRODUCTION=0

# ----------------------------------------------------------------------
# PERSISTENCE & STORAGE
# ----------------------------------------------------------------------
# Directory for SQLite database, state snapshots, and submission write-ahead logs
CITADEL_DATA_DIR=./citadel-server/state

# Logging verbosity: trace | debug | info | warn | error
CITADEL_LOG_LEVEL=info

3 ----------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ----------------------------------------------------------------------
# Secret key used for signing session tokens and proctor administrative routes
CITADEL_ADMIN_SECREL=citadel-master-secret-change-for-production-deployment
# ----------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (OPTIONAL / TESTING ONLY)
# ----------------------------------------------------------------------
# External LLM gateway key for testing problem authoring in dev mode only
SELORA_API_KEY=
